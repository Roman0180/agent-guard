{
  "name": "@agentguard/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm --filter @agentguard/storage build && tsc -p tsconfig.json",
    "dev": "pnpm --filter @agentguard/storage build && tsc -p tsconfig.json && node dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "pnpm --filter @agentguard/storage build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @agentguard/storage build && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentguard/storage": "workspace:^",
    "fastify": "^4.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
