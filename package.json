{
  "name": "agent-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first runtime reliability sidecar for AI coding agents.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev:daemon": "pnpm --filter @agentguard/daemon dev",
    "dev:dashboard": "pnpm --filter @agentguard/dashboard dev",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
