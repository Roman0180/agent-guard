{
  "version": 3,
  "trace_dir": ".agent-sidecar/sessions",
  "daemon": {
    "api_port": 7433,
    "otlp_port": 4318
  },
  "models": {
    "roles": {
      "reasoning": {
        "model": "sidecar-llama3-reasoning",
        "fallback_base": "llama3:latest",
        "serving": "ollama"
      },
      "coding": {
        "model": "sidecar-llama3-coding",
        "fallback_base": "llama3:latest",
        "serving": "ollama"
      }
    },
    "endpoints": {
      "ollama": {
        "api_base": "http://OPERATOR-TAILSCALE-IP:11434",
        "litellm_prefix": "ollama_chat/"
      }
    },
    "allowlist": [
      "ollama_chat/*@http://OPERATOR-TAILSCALE-IP:11434"
    ],
    "remote_fallback": true,
    "timeout_ms": 9000,
    "max_tokens": 256
  }
}
